<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="API Regression Test Suite" verbose="4">


	<listeners>
		<listener class-name="com.aventstack.chaintest.plugins.ChainTestListener" />
		<!-- <listener class-name="com.qa.api.listeners.AnnotationTransformer" /> -->
	</listeners>

	<!-- GoRest APIs -->
	<test name="Go Rest API Test - Get User">
		<classes>
			<class name="com.qa.api.gorest.tests.GetUserTest" />
		</classes>
	</test>
	<test name="Go Rest API Test - Create User">
		<classes>
			<class name="com.qa.api.gorest.tests.CreateUserTest" />
		</classes>
	</test>
	 <test name="Go Rest API Test - Update User">
		<classes>
			<class name="com.qa.api.gorest.tests.UpdateUserTest" />
		</classes>
	</test>
	<test name="Go Rest API Test - Delete User">
		<classes>
			<class name="com.qa.api.gorest.tests.DeleteUserTest" />
		</classes>
	</test>
	<test name="Go Rest API Test - Create User with Deserialization">
		<classes>
			<class
				name="com.qa.api.gorest.tests.DeserializationTest" />
		</classes>
	</test>


	<!-- FakeProduct APIs -->
	<test name="Product API Test - Get Product">
		<classes>
			<class name="com.qa.api.products.tests.GetProductsTest" />
		</classes>
	</test>

	<test name="Product API Test - Get Product With Json Path">
		<classes>
			<class
				name="com.qa.api.products.tests.GetProductsWithJsonPathTest" />
		</classes>
	</test>


	<!-- Schema validations -->
	<test name="Schema Test">
		<classes>
			<class name="com.qa.api.schemavalidation.tests.GoRestSchemaTest" />
		</classes>
	</test>


	<!-- Auth validations -->
	<test name="Basic Auth API Test">
		<classes>
			<class name="com.qa.api.auth.tests.BasicAuthTest" />
		</classes>
	</test>
	<test name="Spotify OAuth API Test">
		<classes>
			<class name="com.qa.api.spotify.tests.SpotifyAPITest" />
		</classes>
	</test>
	<test name="Google Gemini LLM Test">
		<classes>
			<class name="com.qa.api.gemini.google.tests.GoogleGeminiPromptTest" />
		</classes>
	</test> 

</suite>	
